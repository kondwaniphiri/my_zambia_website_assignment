<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Zambia - <%= h1%>  </title>
    <link rel="stylesheet" href="stylesheets/nav.css">
    <link rel="stylesheet" href="stylesheets/navMobile.css">
    <link rel="stylesheet" href="stylesheets/chilldetails.css">
    <link rel="stylesheet" href="stylesheets/chilldetailsMobile.css">
    <link rel="stylesheet" href="stylesheets/aos.css">
    <link rel="stylesheet" href="stylesheets/fontawesome/css/all.css">
    <link rel="stylesheet" href="stylesheets/fontawesome-free-6.6.0-web/css/all.css">
    <script src="javascripts/jquery-3.6.0.min.js"></script>
</head>
<body>

  <header>
    
    <nav id="nav1">
      <img src="images/logo.png" alt="" class="logo">
      <ul class="links">
        <li><a href="/">Home</a></li>
        <li><a href="chill">Chill Spots</a></li>
        <li><a href="attractions">Physical Attractions</a></li>
        <li><a class="useruser"><i class="fa fa-user"></i> <%=username %></a></li>
        <li><a href="logout"><i class="fa-solid fa-right-from-bracket"></i></a></li>
        <div>
          <input type="text" name="search" id="search" placeholder="Search">
        </div>
      </ul>
    </nav>
  
    <nav id="nav2">
      <img src="images/logo.png" alt="" class="logo">
      <span id="navBarTrigger"><i class="fas fa-bars" ></i><span id="x">X</span></span>
      <ul class="links2">
        <div>
          <input type="text" name="search" id="search2" placeholder="Search">
        </div>
        <li><a class="useruser"><i class="fa fa-user"></i> <%=username %></a></li>
        <li><a href="/">-> Home</a></li>
        <li><a href="chill">-> Chill Spots</a></li>
        <li><a href="attractions">-> Physical Attractions</a></li>
        <li><a href="logout"><i class="fa-solid fa-right-from-bracket"> </i> Logout</a></li>
  
      </ul>
    </nav>
  
  </header>
  

<section class="search">
  <div class="topLayer">
    <input type="text" class="searchBar">
    <span class="close">X</span>
  </div>

  <div class="searchContent">
     You are able to search
  </div>
</section>

      <%= %>
    <span id="locationId"><%= pp%></span>
    <span id="userId"><%= uId%></span>

    <section class="main">
        <img src="<%= img1%>" alt="">
        <div class="det">
            <h1><%= h1%></h1>
            <h2><%= h2%></h2>
            <p><%= p%></p>
            <p><%= details%></p>
        </div>
    </section>

    <section class="gallery">
        <h1>Gallery</h1>
        <div>
            <img src="<%= img2%>" alt="">
        </div>
        <div>
            <img src="<%= img3%>" alt="">
        </div>
        <div>
            <img src="<%= img4%>" alt="">
        </div>
    </section>



    <section class="ratings">
      <h1>Ratings</h1>

    <div class="ratingContainer">

    </div>

    <form class="addReview">
      <h3 class="close">X</h3>
      </h3>
      <h3 class="username"><%= username%> </h3>
      <h3 style="display:none" class="userId"><%= uId%> </h3>
      <h3><span class="locId"><%= pp%></span>. <span><%= h1%>  <%= h2%></span></h3>
      <div class="stars2">
        <i class="fa-regular fa-star"></i>
        <i class="fa-regular fa-star"></i>
        <i class="fa-regular fa-star"></i>
        <i class="fa-regular fa-star"></i>
        <i class="fa-regular fa-star"></i>
      </div>
      <label for="inputRating">Rating (1-5)</label>
      <input id="inputRating" type="number" min="0" max="5" step="0.5" >
      <label for="inputComment">Comment</label>
      <textarea name="" id="inputComment"></textarea>
      <button class="addButton">Add</button>
      <button class="editButton">Edit</button>
      <button class="deleteButton">Delete</button>
    </form>

    <div class="reviewActions">
      <button class="addRating">
        Add Review
      </button>
      <button class="editRating">
        Edit Review
      </button>
      <button class="deleteRating">
        Delete Review
      </button>
    </div>

  </section>

    
    <section class="map">
      
        <iframe src="<%= map%>" width="600" height="300" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        <div class="contact">
            <h1>Contact</h1>
            <h3><i class="fa fa-map-marker"></i> Address: <span><%= address%></span></h3>
            <h3><i class="fa fa-phone"></i>  Phone: <span><%= phone%></span></h3>
            <h3><i class="fa fa-envelope"></i>  Email: <span><%= h1.toLowerCase()+h2.toLowerCase().replace(/\s+/g, '')%>@gmail.com</span></h3>
            <h3><i class="fa fa-globe"></i>  Website: <a href="<%= site%>"><%= site%></a></h3>


        </div>
    </section>


    <footer>
        <div class="socialSection">
          <img src="images/logo.png" alt="">
          <div class="social">
            <a href="#"><i class="fab fa-facebook"></i></a>
            <a href="#"><i class="fab fa-instagram"></i></a>
            <a href="#"><i class="fab fa-twitter"></i></a>
            <a href="#"><i class="fab fa-youtube"></i></a>
            <a href="#"><i class="fab fa-tiktok"></i></a>
          </div>
        </div>
        <div class="leftSide">
          <div class="top">
            <h3>Subscribe For our News Letter</h3>
            <input type="email">
            <button>Send</button>
          </div>
          <div class="bottom">
            <a href="#">Cookie Policy</a>
            <a href="#">Privacy Policy</a>
            <a href="#">Terms and Conditions</a>
            <a href="#">Contact Us</a>
            <a href="#">About Us</a>
          </div>
        </div>
        <h5 class="cpr">All Rights Reserved My Zambia</h5>
        
        </footer>

    <script src="javascripts/reviews.js"></script>
    <script src="javascripts/script.js"></script>
    <script src="javascripts/chill.js"></script>
    <script src="javascripts/search.js"></script>
    <script src="javascripts/chilldetails.js"></script>
</body>
</html>