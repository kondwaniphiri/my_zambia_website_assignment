<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="author" content="Kondwani Phiri">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My zambia - Physical Attractions</title>
    <link rel="stylesheet" href="stylesheets/nav.css">
    <link rel="stylesheet" href="stylesheets/navMobile.css">
    <link rel="stylesheet" href="stylesheets/aos.css">
    <link rel="stylesheet" href="stylesheets/fontawesome-free-6.6.0-web/css/all.css">
    <script src="javascripts/jquery-3.6.0.min.js"></script>
    <script src="/javascripts/security.js"></script>
    <script src="/javascripts/content.js"></script>
    <link rel="stylesheet" href="/stylesheets/site-ui.css">
    <link rel="stylesheet" href="/stylesheets/places.css">
    <link rel="stylesheet" href="/stylesheets/attractions.css">
    <link rel="stylesheet" href="/stylesheets/attractionsMobile.css">
    <link rel="stylesheet" href="/stylesheets/legacy-listings.css">
    <link rel="stylesheet" href="/stylesheets/scrollbars.css">
</head>
<body>

  <%- include('partials/navigation') %>

<section class="search">
  <div class="topLayer">
    <input type="text" class="searchBar" aria-label="Search locations" placeholder="Search places by name">
    <span class="close">X</span>
  </div>

  <div class="searchContent">
     You are able to search
  </div>
</section>

<main class="places-page legacy-page" data-kind="attractions" data-layout="legacy">
    <section class="attSlides">
        <img src="images/attractions/bg.jpg" alt="">
        <div class="landingDetails">
        <h1 id="places-title">Explore Zambia's Stunning Physical Attractions</h1>
        <p>Journey through Zambia's remarkable landscapes and discover awe-inspiring physical attractions. From the mighty Victoria Falls to the tranquil Luangwa Valley, uncover the natural beauty and geological wonders that define Zambia's breathtaking scenery.</p>
        <img src="images/logo.png" alt="">
      </div>
    </section>
    <section class="place-directory" aria-label="Attraction directory">
      <form class="place-filters" aria-label="Filter places">
        <div><label for="place-query">Find a place</label><input id="place-query" type="search" placeholder="Name or location" autocomplete="off"></div>
        <div><label for="place-province">Province</label><select id="place-province"><option value="">All provinces</option></select></div>
        <div><label for="place-activity">Activity</label><select id="place-activity"><option value="">All activities</option></select></div>
        <button type="reset" class="filter-reset">Clear filters</button>
      </form>
      <div class="places-results"><p id="place-results" role="status" aria-live="polite">Loading places&hellip;</p><span>Discover at your own pace</span></div>
      <div class="attractions legacy-attractions" id="place-grid" aria-busy="true"></div>
      <div class="places-empty" hidden><h2>No places match your filters</h2><p>Try another province or activity, or clear your filters to see all places.</p><button type="button" class="empty-reset">Clear filters</button></div>
      <noscript><p>Enable JavaScript to browse and filter the location directory.</p></noscript>
    </section>
</main>

<footer>
        <div class="socialSection">
          <img src="images/logo.png" alt="">
          <div class="social">
            <a href="#"><i class="fab fa-facebook"></i></a>
            <a href="#"><i class="fab fa-instagram"></i></a>
            <a href="#"><i class="fab fa-twitter"></i></a>
            <a href="#"><i class="fab fa-youtube"></i></a>
            <a href="#"><i class="fab fa-tiktok"></i></a>
          </div>
        </div>
        <div class="leftSide">
          <div class="top"><%- include('partials/newsletter') %></div>
          <div class="bottom">
            <a href="#">Cookie Policy</a>
            <a href="#">Privacy Policy</a>
            <a href="#">Terms and Conditions</a>
            <a href="/contact">Contact Us</a>
            <a href="#">About Us</a>
          </div>
        </div>
        <h5 class="cpr">All Rights Reserved My Zambia</h5>
        
        </footer>


        <script src="javascripts/script.js"></script>
        <script src="javascripts/aos.js"></script>
        <script src="/javascripts/places.js"></script>
        <script src="/javascripts/legacy-listings.js"></script>
        <script src="/javascripts/directory.js"></script>
        <script src="javascripts/search.js"></script>
        <script>AOS.init();</script>
    <script src="/javascripts/image-viewer.js"></script>
    <script src="/javascripts/motion.js"></script>
    <script src="/javascripts/mail-forms.js"></script>
</body>
</html>