#!/usr/bin/env node
// Author: Kondwani Phiri

/**
 * Module dependencies.
 */

var app = require('../app');
var debug = require('debug')('medsystem:server');
var http = require('http');

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 */

if (process.env.SESSION_STORE == 'memory') {
  server.listen(port, process.env.HOST || '127.0.0.1');
} else {
  prepareDatabase().then(function() {
    server.listen(port, process.env.HOST || '127.0.0.1');
    var cleanup = setInterval(function() { prepareDatabase().catch(function(error) { console.error('Database cleanup failed:', error.code || error.message); }); }, 10 * 60 * 1000);
    cleanup.unref();
  }).catch(function(error) {
    console.error('Database startup failed. Set database credentials and run npm run migrate:', error.code || error.message);
    process.exitCode = 1;
  });
}

async function prepareDatabase() {
  var connection = await require('../db')();
  try {
    await connection.execute('DELETE FROM app_sessions WHERE expires <= ?', [Date.now()]);
    await connection.execute('DELETE FROM login_limits WHERE expires <= ?', [Date.now()]);
  } finally { await connection.end(); }
}
server.on('error', onError);
server.on('listening', onListening);

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
  require('../services/email-worker').start();
  console.log('MyZambia is running at http://' + (process.env.HOST || '127.0.0.1') + ':' + addr.port);
}
